# Nexoro server.cfg. Generated by recipe.yaml; edit there, or edit this file on your own server.
endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"
sv_maxclients 32
sv_licenseKey "YOUR_CFX_LICENSE_KEY"
set onesync on
set mysql_connection_string "mysql://nexoro:CHANGE_ME@localhost/nexoro?charset=utf8mb4"
set sv_enforceGameBuild 3095

# Standard FiveM resources (do NOT start spawnmanager or basic-gamemode)
ensure mapmanager
ensure sessionmanager
# Do NOT start the default 'chat' resource: nexoro_chat replaces it.

# Database driver: https://github.com/overextended/oxmysql
ensure oxmysql

# Nexoro, in this order
ensure nexoro_database
ensure nexoro_core
ensure nexoro_identity
ensure nexoro_loading
ensure nexoro_ui
ensure nexoro_notifications
ensure nexoro_character
ensure nexoro_banking
ensure nexoro_inventory
ensure nexoro_chat
ensure nexoro_phone
ensure nexoro_hud
ensure nexoro_menu
ensure nexoro_vehicles
ensure nexoro_garages
ensure nexoro_dealerships
ensure nexoro_emergency
ensure nexoro_police
ensure nexoro_ambulance
ensure nexoro_fire
ensure nexoro_dispatch
ensure nexoro_tablet
ensure nexoro_lighting
ensure nexoro_map
ensure nexoro_death
ensure nexoro_world
ensure nexoro_driving
ensure nexoro_shops
ensure nexoro_crafting
ensure nexoro_courts
ensure nexoro_prison
ensure nexoro_housing
ensure nexoro_taxi
ensure nexoro_licences
ensure nexoro_businesses
ensure nexoro_postal
ensure nexoro_fishing
ensure nexoro_transport
ensure nexoro_pawn
ensure nexoro_auctions
ensure nexoro_robbery
ensure nexoro_farming
ensure nexoro_gambling
ensure nexoro_lottery
ensure nexoro_scratchcards
ensure nexoro_supplydrop
ensure nexoro_crews
ensure nexoro_hunting
ensure nexoro_encampments
ensure nexoro_scrapping
ensure nexoro_traveller_site
ensure nexoro_crime
ensure nexoro_markets
ensure nexoro_civilian
ensure nexoro_devtools
ensure nexoro_admin

# Optional: SpiritsCreations Lore-Friendly Car Pack. Install it into resources/ yourself (it is not part of Nexoro).
# Some of its cars need sv_enforceGameBuild 3258 (the pin above is 3095). Uncomment only after installing it.
# ensure Lore-Friendly-Car-Pack

# Optional: Realistic Handling for Vanilla Vehicles by Taira (realistichandlingbyTaira).
# Free to use with credit to Taira. Players download it from the server; nobody installs anything on their PC.
# Install the resource folder into resources/ yourself, then uncomment:
# ensure realistichandlingbytaira

# Test servers only: dev mode turns on the dev commands (/devmoney, /devitem, /devtp, /devheal, /devjob, /devselfcheck)
# and prints a database reset token at startup. Leave this OFF on a live server.
# set nexoro_devmode "true"

# Owner: the licence below is made owner on join (see README "Getting owner").
set nexoro_owner_license "license:YOUR_LICENSE"
